# pvv-config — environment variables
# Copy this file to .env and fill in the values for your local environment.

# SQL Server connection (database pvv_config_db, see /infra/docker-compose.yml)
ConnectionStrings__SqlServer=Server=localhost,1433;Database=pvv_config_db;User Id=sa;Password=PvvLocal123!;TrustServerCertificate=True;

# Redis connection (cache + Pub/Sub for cache invalidation)
ConnectionStrings__Redis=localhost:6379

# JWT issuing (pvv-config issues the operator tokens)
JwtSettings__Secret=CHANGE_ME_dev_only_super_secret_min_32_chars_long
JwtSettings__Issuer=pvv-config

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
