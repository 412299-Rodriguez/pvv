# pvv-soat — environment variables
# Copy this file to .env and fill in the values for your local environment.

# SQL Server connection (database pvv_soat_db, see /infra/docker-compose.yml)
ConnectionStrings__SqlServer=Server=localhost,1433;Database=pvv_soat_db;User Id=sa;Password=PvvLocal123!;TrustServerCertificate=True;

# JWT validation (must match the secret/issuer issued by pvv-config)
JwtSettings__Secret=CHANGE_ME_dev_only_super_secret_min_32_chars_long
JwtSettings__Issuer=pvv-config

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
