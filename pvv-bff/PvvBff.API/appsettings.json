{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "",
    "MongoDB": ""
  },
  "RabbitMQ": {
    "Host": "",
    "VHost": "pvv",
    "User": "",
    "Pass": ""
  },
  "MercadoPago": {
    "AccessToken": "",
    "WebhookSecret": ""
  },
  "Turnstile": {
    "SecretKey": "",
    "Enabled": true
  },
  "Session": {
    "CookieName": "pvv-session",
    "TtlMinutes": 30
  },
  "RateLimit": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Services": {
    "ConfigBaseUrl": "http://localhost:5002",
    "RoutesFile": "ingress-routes.json"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5174" ]
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "pvv-config"
  },
  "AllowedHosts": "*"
}
