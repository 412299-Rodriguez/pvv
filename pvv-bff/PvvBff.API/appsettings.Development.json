{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "MongoDB": "mongodb://pvv_user:pvv_pass@localhost:27017/?authSource=admin"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "VHost": "pvv",
    "User": "pvv_user",
    "Pass": "pvv_pass"
  },
  "MercadoPago": {
    "AccessToken": "CHANGE_ME_mp_access_token",
    "WebhookSecret": "CHANGE_ME_mp_webhook_secret",
    "AutoReturn": false,
    "UseSandbox": false
  },
  "Turnstile": {
    "SecretKey": "1x0000000000000000000000000000000AA",
    "Enabled": true
  },
  "RateLimit": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "Email": {
    "Provider": "Smtp",
    "Host": "smtp-relay.brevo.com",
    "Port": 587,
    "UseStartTls": true
  },
  "Payments": {
    "Gateway": "MercadoPago",
    "AbandonmentTtlMinutes": 30,
    "AbandonmentScanSeconds": 30
  },
  "Leads": {
    "AbandonmentTtlMinutes": 1
  },
  "JwtSettings": {
    "Secret": "dev_only_super_secret_min_32_chars_long_change_me",
    "Issuer": "pvv-config"
  }
}
