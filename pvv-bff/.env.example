# pvv-bff — environment variables
# Copy this file to .env and fill in the values for your local environment.

# Redis connection (sessions, ingress routes, config cache)
ConnectionStrings__Redis=localhost:6379

# MongoDB connection (leads, event logs)
ConnectionStrings__MongoDB=mongodb://pvv_user:pvv_pass@localhost:27017/?authSource=admin

# RabbitMQ (publishes emission messages to pvv-emission)
RabbitMQ__Host=localhost
RabbitMQ__VHost=pvv
RabbitMQ__User=pvv_user
RabbitMQ__Pass=pvv_pass

# Mercado Pago (payments)
MercadoPago__AccessToken=CHANGE_ME_mp_access_token
MercadoPago__WebhookSecret=CHANGE_ME_mp_webhook_secret

# Cloudflare Turnstile (anti-bot)
Turnstile__SecretKey=CHANGE_ME_turnstile_secret_key

# JWT validation (must match the secret issued by pvv-config)
JwtSettings__Secret=CHANGE_ME_dev_only_super_secret_min_32_chars_long

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
