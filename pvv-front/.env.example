# pvv-front — environment variables
# Copy this file to .env and fill in the values for your local environment.
# Note: only variables prefixed with VITE_ are exposed to the client bundle.

# pvv-bff base URL (all requests go through the BFF / ingress pattern)
VITE_BFF_BASE_URL=http://localhost:5003

# Cloudflare Turnstile site key (anti-bot widget)
VITE_TURNSTILE_SITE_KEY=CHANGE_ME_turnstile_site_key

# Company token (AES-256 hashed company id used in the ?c= URL param)
VITE_COMPANY_TOKEN=CHANGE_ME_company_token
