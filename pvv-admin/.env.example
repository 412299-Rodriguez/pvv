# pvv-admin — environment variables
# Copy this file to .env and fill in the values for your local environment.
# Note: only variables prefixed with VITE_ are exposed to the client bundle.

# pvv-bff base URL (reads leads and analytics data)
VITE_BFF_BASE_URL=http://localhost:5003

# pvv-config base URL (company / product / pricing / appearance CRUD)
VITE_CONFIG_API_BASE_URL=http://localhost:5002

# pvv-front base URL (used to build the portal link inside a recovery email)
VITE_PORTAL_BASE_URL=http://localhost:5173

# JWT secret (used for local token handling/validation in dev)
VITE_JWT_SECRET=CHANGE_ME_dev_only_super_secret_min_32_chars_long
