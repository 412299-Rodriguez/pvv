# pvv-emission — environment variables
# Copy this file to .env and fill in the values for your local environment.

# MongoDB connection (emission status tracking)
ConnectionStrings__MongoDB=mongodb://pvv_user:pvv_pass@localhost:27017/?authSource=admin

# RabbitMQ (consumes pvv_emission_queue)
RabbitMQ__Host=localhost
RabbitMQ__VHost=pvv
RabbitMQ__User=pvv_user
RabbitMQ__Pass=pvv_pass

# pvv-soat internal API (issues the policies)
PvvSoatApi__BaseUrl=http://localhost:5001

# .NET environment
ASPNETCORE_ENVIRONMENT=Development
